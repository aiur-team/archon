# Operator environment for the hosted publishing application (contract C6).
#
# This file is an EXAMPLE. Every value below is a placeholder, and none of them
# is a real domain, a real GitHub OAuth application or a real secret. Copy the
# keys, not the values.
#
# These five keys are set in the Netlify site environment for the `hosted/` site,
# never in `hosted/netlify.toml` and never in this repository. A value committed
# here would be a value in git, and values declared in `netlify.toml` are
# build-scoped rather than available to a function at runtime, so putting them
# there would also be wrong on the mechanics. `hosted/lib/config.mjs` reads
# exactly these five keys and nothing else.
#
# `hosted/OPERATIONS.md` is the runbook: which site each key belongs to, which
# deploy contexts to scope it to, how to register the OAuth callback, and what
# turning publishing off does and does not do.

# The application origin. Scheme, host and optional port only -- no path, no
# trailing slash, no credentials, no wildcard. Must be https:// in production.
# This is the origin the browser signs in to and the origin `/docs/<id>` is
# served from.
HOSTED_APP_ORIGIN=https://app.example.com

# The renderer origin: the separate, static, cookie-free deployment that frames
# uploaded HTML. It must be a different *registrable site* from the application,
# not a sibling subdomain of it -- the application refuses to start otherwise.
# `app.example.com` and `render.example.com` would be rejected; the two
# placeholders below are two different sites.
HOSTED_RENDER_ORIGIN=https://render.example.net

# The GitHub OAuth application's client id. Public: it appears in the
# authorization URL a browser is redirected to, so it is not a secret. This is a
# dedicated OAuth application requesting an EMPTY scope; see OPERATIONS.md for
# the exact registration, including the one callback URL it may have.
GITHUB_CLIENT_ID=Iv1.0000000000000000

# The GitHub OAuth application's client secret. A real secret: set it only in the
# Netlify site environment, only for the application site, and never for the
# renderer site or a deploy-preview context that a pull request can build.
# The placeholder below is not a credential.
GITHUB_CLIENT_SECRET=example-not-a-real-client-secret

# The publishing tap. Must be spelled exactly "true" or "false"; anything else is
# a configuration error rather than a falsy default, and unset means disabled.
#
# The example ships DISABLED on purpose. A deployment that reaches production
# with this file's defaults refuses to start new publications rather than opening
# an unmetered public endpoint. Turning it off later refuses new starts; it does
# not revoke an authorization a user already holds, and it never disables an
# owner reading a document they already published. OPERATIONS.md states the exact
# observed semantics.
HOSTED_PUBLISH_ENABLED=false

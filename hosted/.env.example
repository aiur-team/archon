# Operator environment for the hosted publishing application (contract C6).
#
# This file is an EXAMPLE. Every value below is a placeholder, and none of them
# is a real domain, a real Auth0 application or a real secret. Copy the keys, not
# the values.
#
# These keys are set in the Netlify site environment for the hosted application,
# never in `netlify.toml` and never in this repository. A value committed here
# would be a value in git, and values declared in `netlify.toml` are build-scoped
# rather than available to a function at runtime, so putting them there would
# also be wrong on the mechanics. The hosted config module reads exactly these
# keys and nothing else.
#
# `hosted/OPERATIONS.md` is the runbook: which site each key belongs to, which
# deploy contexts to scope it to, how to register the OAuth callback, and what
# turning publishing off does and does not do.

# The application origin. Scheme, host and optional port only -- no path, no
# trailing slash, no credentials, no wildcard. Must be https:// in production.
# This is the origin the browser signs in to and the origin `/docs/<id>` is
# served from.
HOSTED_APP_ORIGIN=https://app.example.com

# The renderer origin: the separate, static, cookie-free deployment that frames
# uploaded HTML. It must be a different *registrable site* from the application,
# not a sibling subdomain of it -- the application refuses to start otherwise.
# `app.example.com` and `render.example.com` would be rejected; the two
# placeholders below are two different sites.
HOSTED_RENDER_ORIGIN=https://render.example.net

# The Auth0 tenant domain. A bare host: no scheme, no path, no trailing slash.
# The authorize, token, JWKS and logout URLs are all built from it, so a value
# that carried a scheme or a path would be a redirect-to-anywhere primitive. Use
# your tenant domain (for example `your-tenant.us.auth0.com`) or your Auth0
# custom domain. See OPERATIONS.md for the application registration.
AUTH0_DOMAIN=your-tenant.example.com

# The Auth0 application's client id. Public: it appears in the authorization URL
# a browser is redirected to, so it is not a secret. This is a Regular Web App
# with the Google and GitHub connections enabled; see OPERATIONS.md for the exact
# registration, including the allowed callback and logout URLs.
AUTH0_CLIENT_ID=exampleAuth0ClientId0000000000000

# The Auth0 application's client secret. A real secret: set it only in the
# Netlify site environment, only for the application site, and never for the
# renderer site or a deploy-preview context that a pull request can build.
# The placeholder below is not a credential.
AUTH0_CLIENT_SECRET=example-not-a-real-client-secret

# The publishing tap. Must be spelled exactly "true" or "false"; anything else is
# a configuration error rather than a falsy default, and unset means disabled.
#
# The example ships DISABLED on purpose. A deployment that reaches production
# with this file's defaults refuses both to start a publication and to commit
# uploaded bytes, rather than opening an unmetered public endpoint. It does not
# revoke an approval a user already gave, and it never disables an owner reading
# a document they already published or an agent recovering a receipt it already
# earned. OPERATIONS.md states the exact semantics and how to verify them.
HOSTED_PUBLISH_ENABLED=false

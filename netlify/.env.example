# Operator environment for the one Archon site.
#
# This file is an EXAMPLE. Every value below is a placeholder, and none of them
# is a real domain, a real Auth0 application or a real secret. Copy the keys, not
# the values.
#
# There is one Netlify site and one deploy tree, so there is one environment and
# one copy of this file. The site answers on two hostnames -- the application
# hostname and the renderer hostname -- and the host-aware edge gate in
# `netlify/edge-functions/gate.ts` decides which of the two a request arrived on.
# Both hostnames therefore read the same values; nothing here is set twice.
#
# This file lives inside the deploy tree, beside the reader that consumes it. It
# is never deployed as configuration and nothing imports it -- it is a template
# to copy keys out of.
#
# Set these in the Netlify site environment (Site configuration -> Environment
# variables), never in `netlify.toml` and never in this repository. A value
# committed here would be a value in git, and values declared in `netlify.toml`
# are build-scoped rather than available to a function at runtime, so putting
# them there would also be wrong on the mechanics.
#
# `netlify/lib/hosted/config.mjs` reads exactly the keys below and nothing else.
# The collaboration layer reads a few more of its own -- `ABLY_API_KEY`,
# `DOC_OWNERS`, `SLACK_WEBHOOK_URL` and the four `DOCS_*`
# names -- which the "Configuration" table in the repository `README.md` lists.
# They are not repeated here, because a key in this file that the hosted
# configuration reader does not read is a key a test would have to stop
# checking.
#
# `hosted/OPERATIONS.md` is the runbook: what each key does, how to register the
# Auth0 application, what turning publishing off does and does not do, and why
# changing a value here changes nothing until the next deploy. `README.md`'s
# "Hosting" section is the short version, in order, for a first setup.

# The application origin. Scheme, host and optional port only -- no path, no
# trailing slash, no credentials, no wildcard. Must be https:// in production.
# This is the site's primary custom domain: the hostname a visitor signs in on
# and the one `/docs/<id>` is served from. The edge gate treats a request on
# this host as the application; a request on any host it does not recognise is
# refused rather than guessed at.
HOSTED_APP_ORIGIN=https://app.example.com

# The renderer origin: the cookie-free hostname that frames uploaded HTML. It is
# the *same Netlify site* on its second hostname -- in a real setup, the site's
# own `<name>.netlify.app` name, which Netlify keeps serving alongside the
# primary custom domain and does not redirect.
#
# It must be a different *registrable site* from the application, not a sibling
# subdomain of it -- the application refuses to start otherwise, and that rule is
# unchanged. `app.example.com` and `render.example.com` would be rejected;
# `app.example.com` and a `*.netlify.app` name are two different registrable
# sites, which is exactly what makes one Netlify site enough. The two
# placeholders below are likewise two different sites.
HOSTED_RENDER_ORIGIN=https://render.example.net


# The Auth0 tenant domain. A bare host: no scheme, no path, no trailing slash.
# The authorize, token, JWKS and logout URLs are all built from it, so a value
# that carried a scheme or a path would be a redirect-to-anywhere primitive. Use
# your tenant domain (for example `your-tenant.us.auth0.com`) or your Auth0
# custom domain. See `hosted/OPERATIONS.md` §3 for the application registration.
AUTH0_DOMAIN=your-tenant.example.com

# The Auth0 application's client id. Public: it appears in the authorization URL
# a browser is redirected to, so it is not a secret. This is a Regular Web App
# with the Google and GitHub connections enabled and every other connection
# disabled; see `hosted/OPERATIONS.md` §3 for the exact registration, including
# the one allowed callback URL and the one allowed logout URL.
AUTH0_CLIENT_ID=exampleAuth0ClientId0000000000000

# The Auth0 application's client secret. A real secret: set it in the Netlify
# site environment and mark it *secret* there, so the value stops being readable
# back out of the UI, the API and the deploy log.
#
# Netlify's free plan cannot scope a variable to functions only: every value is
# site-wide, which means the build step can read this one. The mitigation is
# that no build-time code reads it -- `templates/build --site` never imports
# `netlify/lib/hosted/config.mjs`, and only the deployed functions call
# `config.auth0.readClientSecret()`. Do not set it on a deploy-preview context
# that a pull request can build.
#
# The placeholder below is not a credential.
AUTH0_CLIENT_SECRET=example-not-a-real-client-secret

# The publishing tap. Must be spelled exactly "true" or "false"; anything else is
# a configuration error rather than a falsy default, and unset means disabled.
#
# The example ships DISABLED on purpose. A deployment that reaches production
# with this file's defaults refuses both to start a publication and to commit
# uploaded bytes, rather than opening an unmetered public endpoint. It does not
# revoke an approval a user already gave, and it never disables an owner reading
# a document they already published or an agent recovering a receipt it already
# earned. `hosted/OPERATIONS.md` §4 states the exact semantics and how to
# verify them.
HOSTED_PUBLISH_ENABLED=false

# Whether a document owner may list a public mailbox provider -- gmail.com,
# outlook.com, yahoo.com and the rest of the frozen list in
# `netlify/lib/hosted/domain-access.mjs` -- as a domain that may read their
# document. Must be spelled exactly "true" or "false"; anything else is a
# configuration error rather than a falsy default, and unset means refused.
#
# Leave it refused unless you know why you are changing it. Listing gmail.com on
# a document admits every person on earth who can sign up for an address, which
# is publishing the document while believing it is private. The switch exists for
# a deployment where these really are the corporate mailboxes, and it is
# site-wide: there is no per-document override and no per-owner exception.
#
# Turning it back off does not break a document whose list was set while it was
# on. The rule is enforced when an owner writes a list, not when a reader is
# admitted by one, so an already-stored list keeps working and simply cannot be
# set again until the entry is removed.
ARCHON_ALLOW_PUBLIC_MAIL_DOMAINS=false

  "decisions": [
    {
      "id": "DEC-001",
      "decision": "Agent-produced single-file HTML, no repository integration",
      "rationale": "The user selected upload plus GitHub identity over required repository access; preserve local portability."
    },
    {
      "id": "DEC-002",
      "decision": "Dedicated hosted GitHub OAuth and session seam",
      "rationale": "Published Netlify Identity does not establish stable GitHub-ID linkage; preserve its legacy users rather than migrate them."
    },
    {
      "id": "DEC-003",
      "decision": "Single-record atomic publication in strong Blobs store",
      "rationale": "One CAS commits bytes and owner together; removes cross-record commit and cleanup races at the chosen 2MiB limit."
    },
    {
      "id": "DEC-004",
      "decision": "Separate cookie-free renderer on another registrable site",
      "rationale": "Active HTML cannot execute on the account origin; exact-origin messaging plus an opaque nested sandbox protects credentials."
    },
    {
      "id": "DEC-005",
      "decision": "Split-phase operation-scoped agent capability",
      "rationale": "Browser confirmation binds owner; bounded resume/status and 24-hour receipt recovery survive agent timeouts without leaking GitHub credentials."
    },
    {
      "id": "DEC-006",
      "decision": "Private-first pilot with explicit live-release gates",
      "rationale": "No sharing was selected; defer hard quotas and unrestricted rollout while testing an operator-bounded pilot."
    },
    {
      "id": "DEC-007",
      "decision": "Preserve self-hosted deployment and build profile",
      "rationale": "Root gate/connect/access stay unchanged; hosted output removes legacy remote/collaboration dependencies without redefining existing documents."
    }
  ],

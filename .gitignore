.env
.env.*
!.env.example
node_modules/
templates/docbuild/dist/
.DS_Store
_site/

# A hosted-profile artifact is built on demand for one private upload, never
# committed. Documents commit their normal dist/<instance>.html; this keeps a
# `git add <instance>` after `docbuild <instance> --hosted` from carrying the
# hosted twin along with it.
**/dist/*.hosted.html

# The renderer's deployable tree is generated by `renderer/scripts/build.mjs`
# from the committed sources plus the operator's configured origins. It is
# rebuilt on every deploy and must never be committed: a checked-in copy would
# carry one deployment's application origin into every other one.
renderer/dist/
